// fpboard — what the order package needs to know about a board.
//
// The board file is read here for the facts a manufacturer asks about:
// the count of copper layers, the thickness, the size of the outline, the
// narrowest track, the smallest drills and annular rings, and for every
// footprint its reference, name, side, anchor, rotation, do-not-populate
// flag, fields, and the centre of its pads.  The outline comes from
// kicad-pcb-nv; the rest is read from the S-expressions with sexpr-nv.
//
// The centre of a footprint's pads is the position the manufacturer's
// placement wants, and it is not the footprint's anchor: the Fabrication
// Toolkit takes the centre of the box that holds every pad.  A pad's box
// is its `size`, turned by the pad's own angle relative to the footprint
// (the angle a board file stores for a pad includes the footprint's), and
// the centre of the union is turned by the footprint's rotation to the
// board.  A pad of a custom shape counts as its anchor's size.

use sexprtree
use kpcbgeom
use kpcbread
use fpfault

// A footprint on the board.
//
// `side` is `top` or `bottom`.  `x`, `y` and `rot` are the anchor and the
// rotation as the file gives them (y grows downward), `cx` and `cy` the
// centre of the pads on the board and `pads` how many there are.
// `dnp`, `no_pos` and `no_bom` are the attributes `dnp`,
// `exclude_from_pos_files` and `exclude_from_bom`.  `keys` and `vals` are
// the fields.
pub struct Part
    ref: Str
    value: Str
    name: Str
    side: Str
    x: Float
    y: Float
    rot: Float
    cx: Float
    cy: Float
    pads: Int
    dnp: Bool
    no_pos: Bool
    no_bom: Bool
    keys: [Str]
    vals: [Str]

// What is read of a board.
//
// `width` and `height` are the outline's box, `min_track` the width of
// the narrowest track or zero when the board has none, `min_via_drill`
// and `min_via_size` those of the smallest via (zero for none),
// `min_pth` the smallest plated drill of a pad, `min_npth` the smallest
// non-plated one, and `min_ring` the smallest annular ring of a via or a
// plated pad.  A zero says none was found.  `aux_x` and `aux_y` are the
// auxiliary axis origin, which the placement file is relative to.
pub struct FabBoard
    file: Str
    layers: Int
    thickness: Float
    width: Float
    height: Float
    aux_x: Float
    aux_y: Float
    min_track: Float
    min_via_drill: Float
    min_via_size: Float
    min_pth: Float
    min_npth: Float
    min_ring: Float
    parts: [Part]

// The smaller of two measures where zero means that none was found.
fn least(a: Float, b: Float) -> Float
    if a == 0.0
        b
    elif b == 0.0
        a
    else
        math.min(a, b)

// The text of child `i` of list `n`, or the empty string.
fn text_at(t: SexprTree, n: Int, i: Int) -> Str
    let c = sexprtree.nth(t, n, i)
    if c < 0
        ""
    else
        sexprtree.text(t, c)

// The number that is child `i` of list `n`, or `fallback`.
fn num_at(t: SexprTree, n: Int, i: Int, fallback: Float) -> Float
    let c = sexprtree.nth(t, n, i)
    if c < 0
        fallback
    else
        sexprtree.as_float(t, c) ?? fallback

// The count of copper layers: the layers of the `layers` form named
// `*.Cu`.
fn count_copper(t: SexprTree) -> Int
    let l = sexprtree.find(t, 0, "layers")
    var n = 0
    if l >= 0
        for c in sexprtree.children(t, l)
            if str.ends_with(text_at(t, c, 1), ".Cu")
                n += 1
    n

// The auxiliary axis origin, `[x, y]`, or zeros.
fn aux_origin(t: SexprTree) -> [Float]
    let s = sexprtree.find(t, 0, "setup")
    if s < 0
        return [0.0, 0.0]
    let a = sexprtree.find(t, s, "aux_axis_origin")
    if a < 0
        [0.0, 0.0]
    else
        [num_at(t, a, 1, 0.0), num_at(t, a, 2, 0.0)]

// The half extents `[ex, ey]` of a `w` by `h` rectangle turned by `deg`.
fn half_extents(w: Float, h: Float, deg: Float) -> [Float]
    let c = math.abs(kpcbgeom.cos_deg(deg))
    let s = math.abs(kpcbgeom.sin_deg(deg))
    [(w * c + h * s) / 2.0, (w * s + h * c) / 2.0]

// The box of the pads of footprint `n` in its own frame, as
// `[x0, y0, x1, y1]`, or an empty list when it has none.
fn pad_box(t: SexprTree, n: Int, fp_rot: Float) -> [Float]
    var x0 = math.infinity()
    var y0 = math.infinity()
    var x1 = -math.infinity()
    var y1 = -math.infinity()
    var any = false
    for p in sexprtree.find_all(t, n, "pad")
        let at = sexprtree.find(t, p, "at")
        let sz = sexprtree.find(t, p, "size")
        if at >= 0 and sz >= 0
            let px = num_at(t, at, 1, 0.0)
            let py = num_at(t, at, 2, 0.0)
            let e = half_extents(num_at(t, sz, 1, 0.0),
                num_at(t, sz, 2, num_at(t, sz, 1, 0.0)),
                num_at(t, at, 3, fp_rot) - fp_rot)
            x0 = math.min(x0, px - e[0])
            y0 = math.min(y0, py - e[1])
            x1 = math.max(x1, px + e[0])
            y1 = math.max(y1, py + e[1])
            any = true
    if any
        [x0, y0, x1, y1]
    else
        []

// The atoms of a footprint's `attr` form.
fn attrs_of(t: SexprTree, n: Int) -> [Str]
    let a = sexprtree.find(t, n, "attr")
    if a < 0
        []
    else
        list.map(sexprtree.children(t, a), c => sexprtree.text(t, c))

// The part that footprint form `n` is.
fn part_of(t: SexprTree, n: Int) -> Part
    let at = sexprtree.find(t, n, "at")
    let x = num_at(t, at, 1, 0.0)
    let y = num_at(t, at, 2, 0.0)
    let rot = num_at(t, at, 3, 0.0)
    var keys: [Str] = []
    var vals: [Str] = []
    for p in sexprtree.find_all(t, n, "property")
        list.push(keys, text_at(t, p, 1))
        list.push(vals, text_at(t, p, 2))
    for p in sexprtree.find_all(t, n, "fp_text")
        let which = text_at(t, p, 1)
        if which == "reference" or which == "value"
            list.push(keys, (if which == "reference" then "Reference" else "Value"))
            list.push(vals, text_at(t, p, 2))
    let box = pad_box(t, n, rot)
    var center = Pt { x: x, y: y }
    if list.len(box) == 4
        center = kpcbgeom.rotate_local((box[0] + box[2]) / 2.0, (box[1] + box[3]) / 2.0, Pt { x: x, y: y }, rot)
    let attrs = attrs_of(t, n)
    let layer = text_at(t, sexprtree.find(t, n, "layer"), 1)
    let value = field_of(keys, vals, "Value")
    Part { ref: field_of(keys, vals, "Reference"),
        value: value,
        name: text_at(t, n, 1),
        side: (if str.starts_with(layer, "B.") then "bottom" else "top"),
        x: x,
        y: y,
        rot: rot,
        cx: center.x,
        cy: center.y,
        pads: list.len(sexprtree.find_all(t, n, "pad")),
        dnp: list.contains(attrs, "dnp") or str.upper(value) == "DNP",
        no_pos: list.contains(attrs, "exclude_from_pos_files"),
        no_bom: list.contains(attrs, "exclude_from_bom"),
        keys: keys,
        vals: vals }

// The value of the field `key` of a part, compared without regard to
// letter case, or the empty string.
pub fn field_of(keys: [Str], vals: [Str], key: Str) -> Str []
    var out = ""
    for i in 0..list.len(keys)
        if out == "" and str.lower(keys[i]) == str.lower(key)
            out = vals[i]
    out

// The value of the field `key` of the part, or the empty string.
pub fn field(p: Part, key: Str) -> Str []
    field_of(p.keys, p.vals, key)

// Reads the board file `src`, called `file` in a fault.
pub fn read(src: Bytes, file: Str) -> Result<FabBoard, FpFault> []
    match sexprtree.parse(src)
        Err(e) => Err(FpBoard("${file}: ${e.message()}"))
        Ok(t)  =>
            match kpcbread.read(src, file)
                Err(e) => Err(FpBoard(e.message()))
                Ok(b)  => Ok(facts(t, file, b.thickness, b.box.x1 - b.box.x0, b.box.y1 - b.box.y0))

// The facts of a parsed board.
fn facts(t: SexprTree, file: Str, thickness: Float, width: Float, height: Float) -> FabBoard
    var track = 0.0
    var via_drill = 0.0
    var via_size = 0.0
    var pth = 0.0
    var npth = 0.0
    var ring = 0.0
    var parts: [Part] = []
    for c in sexprtree.children(t, 0)
        let h = sexprtree.head(t, c)
        if h == "segment" or h == "arc"
            track = least(track, num_at(t, sexprtree.find(t, c, "width"), 1, 0.0))
        elif h == "via"
            let drill = num_at(t, sexprtree.find(t, c, "drill"), 1, 0.0)
            let size = num_at(t, sexprtree.find(t, c, "size"), 1, 0.0)
            via_drill = least(via_drill, drill)
            via_size = least(via_size, size)
            ring = least(ring, (size - drill) / 2.0)
        elif h == "footprint" or h == "module"
            list.push(parts, part_of(t, c))
            for p in sexprtree.find_all(t, c, "pad")
                let d = sexprtree.find(t, p, "drill")
                if d >= 0
                    let oval = text_at(t, d, 1) == "oval"
                    let drill = if oval
                        math.min(num_at(t, d, 2, 0.0), num_at(t, d, 3, 0.0))
                    else
                        num_at(t, d, 1, 0.0)
                    if text_at(t, p, 2) == "np_thru_hole"
                        npth = least(npth, drill)
                    else
                        pth = least(pth, drill)
                        let sz = sexprtree.find(t, p, "size")
                        ring = least(ring,
                            (math.min(num_at(t, sz, 1, 0.0), num_at(t, sz, 2, num_at(t, sz, 1, 0.0))) - drill) / 2.0)
    let aux = aux_origin(t)
    FabBoard { file: file,
        layers: count_copper(t),
        thickness: thickness,
        width: width,
        height: height,
        aux_x: aux[0],
        aux_y: aux[1],
        min_track: track,
        min_via_drill: via_drill,
        min_via_size: via_size,
        min_pth: pth,
        min_npth: npth,
        min_ring: ring,
        parts: parts }
