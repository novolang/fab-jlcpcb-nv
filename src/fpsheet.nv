// fpsheet — the sheet a person reads before ordering on the web.
//
// The package places no order and calls no service.  The sheet says what
// is in the package, which assembly class the board belongs to, what to
// enter on JLCPCB's web form, which rotations to look at in the preview,
// what the checks found, and what the package could not decide.  The
// steps of the form are those of JLCPCB's help page "How do I place a
// PCBA order?" (https://jlcpcb.com/help/article/how-do-i-place-a-pcba-order,
// updated 9 September 2026).

use fpboard
use fpbom
use fpcheck
use fpcpl
use fpdata

// What a package is made of, as the sheet states it.
//
// `name` and `rev` name the design and its revision, `qty` is the
// number of boards or zero, `class` the assembly class, `files` the
// files of the package, and `not_placed` the references the package
// leaves out on purpose.
pub struct Order
    name: Str
    rev: Str
    qty: Int
    class: Str
    files: [Str]
    not_placed: [Str]

// The references of the parts a board has that are not placed: marked
// do-not-populate or left out of the position file.
pub fn not_placed(b: FabBoard) -> [Str] []
    list.map(list.filter(b.parts, p => p.dnp or p.no_pos), p => p.ref)

// The open questions of an order, as lines.
pub fn questions(b: FabBoard, o: Order) -> [Str] []
    var out: [Str] = ["Quantity: how many boards and how many assembled?  The package leaves it to the form" + (if o.qty > 0 then ", and the checks used ${o.qty}." else ".")]
    list.push(out,
        "Surface finish and solder mask colour are not in a board file; the form asks for them.  A finish other than the default is a choice for fine-pitch or BGA parts.")
    list.push(out,
        "Copper weight: every capability figure used is for 1 oz.  A board that needs more copper is checked against other figures.")
    list.push(out,
        "Does the form accept the column names `Comment`, `Designator`, `Footprint`, `JLCPCB Part #`?  They are the ones of the manufacturer's sample file, which carries `(optional)` after the last; not tested against the upload.")
    list.push(out,
        "Does the manufacturer take plated and non-plated holes in one drill file?  The article's steps produce one; not read on a manufacturer page.")
    list.push(out,
        "Are the rotations right?  The table is the Fabrication Toolkit's.  The preview after `Process BOM&CPL` shows each part; correct a part there or give it a rotation field and run again.")
    list.push(out,
        "Is every part in stock, and is any an extended part?  This package does not look.  The part-number list is in `bom.csv`.")
    if o.class == "Standard" and (b.width < 70.0 or b.height < 70.0)
        list.push(out,
            "Standard assembly is given for single boards of 70 by 70 mm and more; this board is ${fpcpl.fixed6(b.width)} by ${fpcpl.fixed6(b.height)} mm.  Is a panel needed, and does the manufacturer make it?")
    if list.len(o.not_placed) > 0
        list.push(out,
            "${list.len(o.not_placed)} part(s) are left out on purpose (${str.join(list.take(o.not_placed, 12), ", ")}).  Is that what is meant?")
    out

// The order sheet as text, in Markdown.
pub fn sheet(b: FabBoard, rows: [Cpl], bom: [BomLine], cs: [FpCheck], o: Order) -> Str []
    let top = list.len(list.filter(rows, r => r.layer == "Top"))
    let bottom = list.len(rows) - top
    var out: [Str] = ["# Order sheet: ${o.name} revision ${o.rev}", ""]
    list.push(out,
        "Prepared by fab-package-nv.  **Nothing has been ordered and no service was called.**  The package is " + (if fpcheck.passes(cs) then "ready to upload." else "NOT READY: a check below is an error."))
    list.push(out, "")
    list.push(out, "## The board")
    list.push(out, "")
    list.push(out, "- Size: ${fpcpl.fixed6(b.width)} by ${fpcpl.fixed6(b.height)} mm")
    list.push(out, "- Copper layers: ${b.layers}")
    list.push(out, "- Thickness: ${fpcpl.fixed6(b.thickness)} mm")
    list.push(out, "- Quantity: " + (if o.qty > 0 then "${o.qty}" else "not chosen"))
    list.push(out, "")
    list.push(out, "## The assembly")
    list.push(out, "")
    list.push(out, "- Class: ${o.class}")
    list.push(out, "- Placed parts: ${list.len(rows)} (${top} on top, ${bottom} on the bottom)")
    list.push(out, "- Bill of materials lines: ${list.len(fpbom.placed(bom))}")
    list.push(out,
        "- Left out on purpose: ${if list.len(o.not_placed) == 0 then "none" else str.join(o.not_placed, ", ")}")
    list.push(out, "")
    list.push(out, "## The files")
    list.push(out, "")
    for f in o.files
        list.push(out, "- `${f}`")
    list.push(out, "")
    list.push(out, "## On the web form")
    list.push(out, "")
    list.push(out,
        "1. Open the quote page and enter the size, the layer count, the thickness and the quantity above.  Upload the Gerber zip.")
    list.push(out,
        "2. Choose the finish and the mask colour.  Switch on PCB Assembly, choose the assembly side${if bottom > 0 then "s (both: parts are on the bottom)" else " (top)"} and the class ${o.class}.  Do not pay for the board until the assembly parameters are chosen: the manufacturer takes the two together.")
    list.push(out,
        "3. Upload `bom.csv` and `cpl.csv` and press Process BOM&CPL.  Review the matched parts; a row that reads No Part Selected is searched by hand.")
    list.push(out, "4. Review the placements in the preview, above all the parts in `corrections.txt`.")
    list.push(out,
        "5. Save to the cart, check the details, enter the address and pay.  Those steps are the person's.")
    list.push(out, "")
    list.push(out, "## Rotation corrections to review")
    list.push(out, "")
    for l in fpcpl.report(rows)
        list.push(out, "- ${l}")
    list.push(out, "")
    list.push(out, "## The checks")
    list.push(out, "")
    for l in fpcheck.report(cs)
        list.push(out, "- ${l}")
    list.push(out, "")
    list.push(out, "## Open questions")
    list.push(out, "")
    for q in questions(b, o)
        list.push(out, "- ${q}")
    list.push(out, "")
    list.push(out, "## Sources of the tables")
    list.push(out, "")
    for s in fpdata.sources()
        list.push(out, "- ${s}")
    str.join(out, "\n") + "\n"
