// fjzip — a ZIP archive of stored files, byte for byte reproducible.
//
// The archive JLCPCB takes holds the Gerber and drill files.  The files
// are stored, not compressed: they are text of a few kilobytes, the
// writer needs no compressor, and the same files give the same archive,
// since every entry carries the fixed date 1980-01-01 00:00 and no
// extra field.  The format is the one of PKWARE's APPNOTE: a local header
// and the bytes of each file, then the central directory, then the end
// record.  Names are the file names without a directory, in the order
// given, and must be ASCII.

use std.bytes

// The CRC-32 of `data`: the polynomial 0xEDB88320, reflected, with the
// initial and final value all ones.  The CRC-32 of `123456789` is
// 0xCBF43926.
//
// ```novo
// use std.bytes
// use fjzip
//
// fn main() [io]
//     println("${fjzip.crc32(bytes.from_str("123456789"))}")   // 3421780262
// ```
pub fn crc32(data: Bytes) -> Int []
    var table: [Int] = []
    for n in 0..256
        var c = n
        for _k in 0..8
            if (c & 1) == 1
                c = 3988292384 ^ (c >> 1)
            else
                c = c >> 1
        list.push(table, c)
    var crc = 4294967295
    for i in 0..bytes.len(data)
        crc = table[(crc ^ (bytes.byte_at(data, i) ?? 0)) & 255] ^ (crc >> 8)
    crc ^ 4294967295

// The local file header of an entry: the signature, the version 10, no
// flags, method 0 (stored), the fixed time and date, the CRC, the sizes
// and the name.
fn local_header(name: Str, crc: Int, size: Int) -> Bytes
    bytes.concat([bytes.u32_le(67324752),
        bytes.u16_le(10),
        bytes.u16_le(0),
        bytes.u16_le(0),
        bytes.u16_le(0),
        bytes.u16_le(33),
        bytes.u32_le(crc),
        bytes.u32_le(size),
        bytes.u32_le(size),
        bytes.u16_le(str.len(name)),
        bytes.u16_le(0),
        bytes.from_str(name)])

// The central directory header of an entry that starts at `offset`.
fn central_header(name: Str, crc: Int, size: Int, offset: Int) -> Bytes
    bytes.concat([bytes.u32_le(33639248),
        bytes.u16_le(10),
        bytes.u16_le(10),
        bytes.u16_le(0),
        bytes.u16_le(0),
        bytes.u16_le(0),
        bytes.u16_le(33),
        bytes.u32_le(crc),
        bytes.u32_le(size),
        bytes.u32_le(size),
        bytes.u16_le(str.len(name)),
        bytes.u16_le(0),
        bytes.u16_le(0),
        bytes.u16_le(0),
        bytes.u16_le(0),
        bytes.u32_le(0),
        bytes.u32_le(offset),
        bytes.from_str(name)])

// The archive that holds the files `names` with the contents `contents`,
// in that order.
//
// ```novo
// use std.bytes
// use fjzip
//
// fn main() [io]
//     let z = fjzip.archive(["a.txt"], [bytes.from_str("hello")])
//     println("${bytes.len(z)}")   // 113
// ```
pub fn archive(names: [Str], contents: [Bytes]) -> Bytes []
    var body = bytes.from_str("")
    var directory = bytes.from_str("")
    for i in 0..list.len(names)
        let data = contents[i]
        let crc = crc32(data)
        let entry = central_header(names[i], crc, bytes.len(data), bytes.len(body))
        body = bytes.concat([body, local_header(names[i], crc, bytes.len(data)), data])
        directory = bytes.concat([directory, entry])
    let end = bytes.concat([bytes.u32_le(101010256),
        bytes.u16_le(0),
        bytes.u16_le(0),
        bytes.u16_le(list.len(names)),
        bytes.u16_le(list.len(names)),
        bytes.u32_le(bytes.len(directory)),
        bytes.u32_le(bytes.len(body)),
        bytes.u16_le(0)])
    bytes.concat([body, directory, end])
