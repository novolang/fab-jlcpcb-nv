// fj_pack_tests — the order package of a revision.
//
// The revision `rev_ok` under tests/fixtures is the output of the gates on
// a small board of three resistors, one of them on the bottom, with two
// mounting holes that are left out of the bill and the positions.  The
// other revisions are written here, with a manifest made by
// hardware-gates-nv, so that each refusal is reached.

use std.test
use std.bytes
use std.fs
use fjpack
use hgcli
use hgmanifest

// A new empty directory made by `mktemp`, named after the test.
fn fresh(name: Str) -> Str [io, fs]
    let made = hgcli.run("mktemp -d /tmp/fj-${name}-XXXXXX")
    test.assert_eq(made.status, 0)
    str.trim(made.output)

// A copy of the fixture revision under tests/_work.
fn copy_of_fixture(name: Str) -> Str [io, fs]
    let dir = fresh(name)
    test.assert_eq(hgcli.run("cp -r tests/fixtures/rev_ok/hardware ${dir}/").status, 0)
    dir

fn pack(root: Str, qty: Int) -> Package [io, fs]
    match fjpack.prepare(root, "rev-A", "mini", qty)
        Ok(p)  => p
        Err(e) =>
            test.assert_eq(e.message(), "")
            Package { dir: "", files: [], checks: [], ready: false, rows: [], class: "" }

fn check_ok(p: Package, name: Str) -> Bool
    var ok = false
    for c in p.checks
        if c.name == name and c.ok
            ok = true
    ok

fn refused(root: Str, rev: Str) -> Str [io, fs]
    match fjpack.prepare(root, rev, "mini", 5)
        Ok(_)  => "prepared"
        Err(e) => e.message()

// A revision `rev-A` under `root/hardware` that has the board text `board`
// as `x.kicad_pcb`, the files named in `have` (bom.csv, pos.csv) with the
// given texts, and a manifest that lists the board and those files.
fn revision(root: Str, board: Str, bom: Str, pos: Str, with_board: Bool) [io, fs]
    let hwdir = "${root}/hardware"
    let rev = "${hwdir}/fab/rev-A"
    test.assert_eq(hgcli.run("mkdir -p ${rev}/gerber").status, 0)
    fs.write("${rev}/gates.json", "{\"passed\": true}")
    fs.write("${rev}/gerber/x.gtl", "G04*\n")
    var outs: [Str] = ["gerber/x.gtl"]
    var ins: [Str] = []
    if with_board
        fs.write("${hwdir}/x.kicad_pcb", board)
        list.push(ins, "x.kicad_pcb")
    if bom != ""
        fs.write("${rev}/bom.csv", bom)
        list.push(outs, "bom.csv")
    if pos != ""
        fs.write("${rev}/pos.csv", pos)
        list.push(outs, "pos.csv")
    let _ = fs.write("${rev}/manifest.json", hgmanifest.build("test", "10.0.8", hwdir, ins, rev, outs))

fn small_board() -> Str
    "(kicad_pcb (version 20241229) (general (thickness 1.6)) (layers (0 \"F.Cu\" signal) (2 \"B.Cu\" signal)) (gr_rect (start 0 0) (end 40 30) (layer \"Edge.Cuts\")) (footprint \"L:R_0603\" (layer \"F.Cu\") (at 5 5) (property \"Reference\" \"R1\") (property \"Value\" \"1k\") (attr smd) (pad \"1\" smd rect (at -1 0) (size 1 1) (layers \"F.Cu\")) (pad \"2\" smd rect (at 1 0) (size 1 1) (layers \"F.Cu\"))))"

fn small_bom() -> Str
    "\"Designator\",\"Comment\",\"Footprint\",\"LCSC\",\"Quantity\"\n\"R1\",\"1k\",\"L:R_0603\",\"C21190\",\"1\"\n"

fn small_pos() -> Str
    "Ref,Val,Package,PosX,PosY,Rot,Side\nR1,1k,L:R_0603,5,-5,0,top\n"

@test
fn test_a_revision_that_passed_its_gates_gets_the_files_of_the_order() [io, fs]
    let root = copy_of_fixture("pk1")
    let p = pack(root, 5)
    test.assert_eq(p.dir, "${root}/hardware/fab/rev-A/jlcpcb")
    test.assert_eq(p.files, ["mini-rev-A-gerbers.zip",
        "bom.csv",
        "cpl.csv",
        "corrections.txt",
        "order-sheet.md",
        "package-manifest.json"])
    test.assert_eq(p.class, "Standard")
    test.assert_eq(list.len(p.rows), 3)
    test.assert(p.ready)
    test.assert_eq(list.len(p.checks), 19)
    for f in p.files
        test.assert((fs.size("${p.dir}/${f}") ?? 0) > 0)
    test.assert_eq(fs.read("${p.dir}/bom.csv") ?? "",
        "Comment,Designator,Footprint,JLCPCB Part #\n10k,R1,0603,C25804\n1k,R2,0603,C21190\n4.7k,R3,0603,C23162\n")
    test.assert_eq(fs.read("${p.dir}/cpl.csv") ?? "",
        "Designator,Mid X,Mid Y,Rotation,Layer\nR1,112,-108,0,Top\nR2,118,-108,90,Top\nR3,112,-112,180,Bottom\n")
    let sheet = fs.read("${p.dir}/order-sheet.md") ?? ""
    test.assert(str.contains(sheet, "# Order sheet: mini revision rev-A"))
    test.assert(str.contains(sheet, "- Left out by the design: H1, H2"))
    test.assert(str.contains(sheet, "- Quantity: 5"))
    let corr = fs.read("${p.dir}/corrections.txt") ?? ""
    test.assert(str.contains(corr, "R3: rotation 0 -> 180, Bottom: the board's own value (unverified)"))
    // The part number of R2 (C21190) has a verified entry, which the bill's number reaches the rows by.
    test.assert(str.contains(corr,
        "R2: rotation 90 -> 90, Top: verified part C21190 (adds 0; seen right on top and bottom on 2026-11-25)"))
    test.assert(str.contains(corr,
        "1 row(s) have a verified part rotation, 0 a proposed one, 0 a part verified on the other side only, 0 a family row, 0 a rotation field and 2 the board's own value"))
    test.assert(str.contains(sheet, "## Rotations not verified"))
    test.assert(str.contains(sheet, "2 of 3 placed parts"))
    test.assert(str.contains(sheet, "- R1 (C25804), written 0 Top: the board's own value (unverified)"))
    test.assert(not str.contains(sheet, "- R2 (C21190), written"))
    test.assert_eq(list.map(p.rows, r => r.source), ["board", "verified", "board"])

@test
fn test_the_package_manifest_holds_the_hashes_of_the_files_and_verifies() [io, fs]
    let root = copy_of_fixture("pk2")
    let p = pack(root, 0)
    let m = fs.read("${p.dir}/package-manifest.json") ?? ""
    test.assert(str.contains(m, "fab-jlcpcb-nv 0.1.1"))
    test.assert(str.contains(m, "\"path\": \"cpl.csv\""))
    test.assert(not str.contains(m, "package-manifest.json\""))
    test.assert_eq(hgmanifest.verify(m, p.dir, p.dir), [])
    fs.write("${p.dir}/cpl.csv", "changed\n")
    test.assert_eq(hgmanifest.verify(m, p.dir, p.dir), ["output cpl.csv changed after it was made"])

@test
fn test_the_same_revision_prepared_twice_gives_the_same_files() [io, fs]
    let root = copy_of_fixture("pk3")
    let a = pack(root, 5)
    let first = list.map(a.files, f => fs.read_bytes("${a.dir}/${f}") ?? bytes.from_str(""))
    let b = pack(root, 5)
    let second = list.map(b.files, f => fs.read_bytes("${b.dir}/${f}") ?? bytes.from_str(""))
    test.assert(first == second)

@test
fn test_the_zip_holds_every_gerber_and_drill_file_and_unzip_accepts_it_when_installed() [io, fs]
    let root = copy_of_fixture("pk4")
    let p = pack(root, 5)
    let archive = "${p.dir}/mini-rev-A-gerbers.zip"
    test.assert((fs.size(archive) ?? 0) > 1000)
    if hgcli.run("command -v unzip").status == 0
        test.assert_eq(hgcli.run("unzip -tq ${archive}").status, 0)
        let names = hgcli.run("unzip -Z1 ${archive}").output
        test.assert(str.contains(names, "mini-F_Cu.gtl"))
        test.assert(str.contains(names, "mini-Edge_Cuts.gm1"))
        test.assert(str.contains(names, "mini.drl"))
    else
        println("skipped: unzip is not installed")

@test
fn test_a_revision_that_has_not_run_or_that_changed_is_refused_with_the_reasons() [io, fs]
    let root = fresh("pk5")
    test.assert(str.contains(refused(root, "rev-A"), "gates.json is missing"))
    let changed = copy_of_fixture("pk5b")
    fs.write("${changed}/hardware/fab/rev-A/bom.csv", "x\n")
    test.assert(str.contains(refused(changed, "rev-A"), "output bom.csv changed after it was made"))
    let moved = copy_of_fixture("pk5c")
    fs.write("${moved}/hardware/mini.kicad_pcb", "(kicad_pcb)\n")
    test.assert(str.contains(refused(moved, "rev-A"), "design file mini.kicad_pcb changed since the outputs were made"))

@test
fn test_a_manifest_that_names_no_board_is_refused() [io, fs]
    let root = fresh("pk6")
    revision(root, "", small_bom(), small_pos(), false)
    test.assert_eq(refused(root, "rev-A"),
        "${root}/hardware/fab/rev-A/manifest.json: names no board file among its inputs")

@test
fn test_a_revision_whose_bill_or_positions_are_missing_or_whose_board_is_not_one_is_refused() [io, fs]
    let a = fresh("pk7a")
    revision(a, small_board(), "", small_pos(), true)
    test.assert_eq(refused(a, "rev-A"), "${a}/hardware/fab/rev-A/bom.csv: cannot be read")
    let b = fresh("pk7b")
    revision(b, small_board(), small_bom(), "", true)
    test.assert_eq(refused(b, "rev-A"), "${b}/hardware/fab/rev-A/pos.csv: cannot be read")
    let c = fresh("pk7c")
    revision(c, "(kicad_sch)", small_bom(), small_pos(), true)
    test.assert(str.contains(refused(c, "rev-A"), "x.kicad_pcb"))
    let d = fresh("pk7d")
    revision(d, small_board(), "\"Designator\"\n", small_pos(), true)
    test.assert(str.contains(refused(d, "rev-A"), "the header lacks"))

@test
fn test_a_written_revision_without_the_fixtures_prepares_and_reads_its_part_field_from_the_policy() [io, fs]
    let a = fresh("pk8a")
    revision(a, small_board(), small_bom(), small_pos(), true)
    let p = pack(a, 0)
    test.assert(check_ok(p, "part-numbers"))
    test.assert_eq(p.class, "Economic")
    let b = fresh("pk8b")
    revision(b, small_board(), small_bom(), small_pos(), true)
    fs.write("${b}/hardware/gates.toml", "[bom]\nthis is not toml\n")
    test.assert(check_ok(pack(b, 0), "part-numbers"))
    let c = fresh("pk8c")
    revision(c,
        small_board(),
        "\"Designator\",\"Comment\",\"Footprint\",\"MPN\"\n\"R1\",\"1k\",\"L:R_0603\",\"C21190\"\n",
        small_pos(),
        true)
    fs.write("${c}/hardware/gates.toml", "[bom]\npart_field = \"MPN\"\n")
    test.assert(check_ok(pack(c, 0), "part-numbers"))

@test
fn test_a_zip_that_cannot_be_written_is_a_refusal_naming_it() [io, fs]
    let root = copy_of_fixture("pk9")
    test.assert_eq(hgcli.run("mkdir -p ${root}/hardware/fab/rev-A/jlcpcb/mini-rev-A-gerbers.zip/in").status, 0)
    test.assert_eq(refused(root, "rev-A"),
        "${root}/hardware/fab/rev-A/jlcpcb/mini-rev-A-gerbers.zip: cannot be written")

// A copy of the fixture revision whose board has an auxiliary origin at
// (100, 100), under a new directory.
fn copy_of_aux_fixture(name: Str) -> Str [io, fs]
    let dir = fresh(name)
    test.assert_eq(hgcli.run("cp -r tests/fixtures/rev_aux/hardware ${dir}/").status, 0)
    dir

@test
fn test_a_board_with_an_auxiliary_origin_is_packaged_with_the_gerbers_in_the_same_origin() [io, fs]
    let root = copy_of_aux_fixture("pk10")
    let p = pack(root, 5)
    test.assert(p.ready)
    test.assert(check_ok(p, "placement-on-gerber"))
    test.assert(check_ok(p, "positions-agree"))
    test.assert_eq(fs.read("${p.dir}/cpl.csv") ?? "",
        "Designator,Mid X,Mid Y,Rotation,Layer\nR1,12,-8,0,Top\nR2,18,-8,90,Top\nR3,12,-12,180,Bottom\n")

@test
fn test_a_part_with_no_number_stops_the_package_at_the_sheet_and_leaves_no_old_files() [io, fs]
    let root = fresh("pk11")
    revision(root,
        small_board(),
        "\"Designator\",\"Comment\",\"Footprint\",\"LCSC\",\"Quantity\"\n\"R1\",\"1k\",\"L:R_0603\",\"\",\"1\"\n",
        small_pos(),
        true)
    let dir = "${root}/hardware/fab/rev-A/jlcpcb"
    test.assert_eq(hgcli.run("mkdir -p ${dir} && echo old > ${dir}/bom.csv").status, 0)
    let p = pack(root, 5)
    test.assert_eq(p.ready, false)
    test.assert_eq(p.files, ["order-sheet.md", "package-manifest.json"])
    test.assert(not fs.exists("${dir}/bom.csv"))
    test.assert(not fs.exists("${dir}/cpl.csv"))
    let sheet = fs.read("${dir}/order-sheet.md") ?? ""
    test.assert(str.contains(sheet, "REFUSED: no file is written but this sheet"))
    test.assert(str.contains(sheet, "1 placed part(s) have no part number in the bill: R1"))

@test
fn test_a_part_listed_as_do_not_place_with_its_reason_is_in_neither_file_and_the_package_goes_on() [io, fs]
    let root = fresh("pk12")
    revision(root,
        small_board(),
        "\"Designator\",\"Comment\",\"Footprint\",\"LCSC\",\"Quantity\"\n\"R1\",\"1k\",\"L:R_0603\",\"\",\"1\"\n",
        small_pos(),
        true)
    fs.write("${root}/hardware/gates.toml", "[do_not_place]\nR1 = \"soldered by hand\"\n")
    let p = pack(root, 5)
    test.assert(check_ok(p, "part-numbers"))
    test.assert_eq(list.len(p.rows), 0)
    test.assert_eq(fs.read("${p.dir}/bom.csv") ?? "", "Comment,Designator,Footprint,JLCPCB Part #\n")
    test.assert_eq(fs.read("${p.dir}/cpl.csv") ?? "", "Designator,Mid X,Mid Y,Rotation,Layer\n")
    let sheet = fs.read("${p.dir}/order-sheet.md") ?? ""
    test.assert(str.contains(sheet, "- Left out by the policy: R1 (soldered by hand)"))

@test
fn test_a_saved_part_page_that_says_standard_only_makes_the_order_standard_and_an_error_on_an_economic_board() [io, fs]
    let root = fresh("pk13")
    revision(root, small_board(), small_bom(), small_pos(), true)
    test.assert_eq(hgcli.run("mkdir -p ${root}/hardware/parts && cp tests/fixtures/parts/C356849.html ${root}/hardware/parts/C21190.html").status,
        0)
    let p = pack(root, 5)
    test.assert_eq(p.class, "Standard")
    test.assert_eq(check_ok(p, "part-assembly-class"), false)
    let sheet = fs.read("${p.dir}/order-sheet.md") ?? ""
    test.assert(str.contains(sheet, "- Class: Standard (forced by R1: only Standard places them)"))
