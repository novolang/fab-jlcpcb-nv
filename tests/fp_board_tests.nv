// fp_board_tests — the facts of a board that the package reads, on boards
// written inline so that every number can be worked out by hand.

use std.test
use std.bytes
use fpboard

// A board file of 20 by 10 mm, two layers, with `setup` and `body`.
fn board_text(setup: Str, body: Str) -> Str
    "(kicad_pcb (version 20241229) (general (thickness 1.2)) (layers (0 \"F.Cu\" signal) (2 \"B.Cu\" signal)) " + setup + " (gr_rect (start 0 0) (end 20 10) (layer \"Edge.Cuts\")) " + body + ")"

// The board of `text`, or an empty one after a failed assertion.
fn read(text: Str) -> FabBoard
    match fpboard.read(bytes.from_str(text), "t.kicad_pcb")
        Ok(b)  => b
        Err(e) =>
            test.assert_eq(e.message(), "")
            FabBoard { file: "",
                layers: 0,
                thickness: 0.0,
                width: 0.0,
                height: 0.0,
                aux_x: 0.0,
                aux_y: 0.0,
                min_track: 0.0,
                min_via_drill: 0.0,
                min_via_size: 0.0,
                min_pth: 0.0,
                min_npth: 0.0,
                min_ring: 0.0,
                parts: [] }

// A footprint `ref` named `name` on `layer` at `at` with `body`.
fn fp(name: Str, ref: Str, layer: Str, at: Str, body: Str) -> Str
    "(footprint \"${name}\" (layer \"${layer}\") (at ${at}) (property \"Reference\" \"${ref}\") (property \"Value\" \"v${ref}\") " + body + ")"

@test
fn test_the_size_layers_thickness_and_origin_of_a_board_are_read()
    let b = read(board_text("(setup (aux_axis_origin 10 5))", ""))
    test.assert_eq(b.file, "t.kicad_pcb")
    test.assert_eq(b.width, 20.0)
    test.assert_eq(b.height, 10.0)
    test.assert_eq(b.layers, 2)
    test.assert_eq(b.thickness, 1.2)
    test.assert_eq(b.aux_x, 10.0)
    test.assert_eq(b.aux_y, 5.0)
    let none = read(board_text("", ""))
    test.assert_eq(none.aux_x, 0.0)
    let no_aux = read(board_text("(setup (pad_to_mask_clearance 0))", ""))
    test.assert_eq(no_aux.aux_y, 0.0)

@test
fn test_inner_layers_are_counted_with_the_copper()
    let text = "(kicad_pcb (version 20241229) (layers (0 \"F.Cu\" signal) (4 \"In1.Cu\" signal) (6 \"In2.Cu\" signal) (2 \"B.Cu\" signal) (5 \"F.SilkS\" user)) (gr_rect (start 0 0) (end 5 5) (layer \"Edge.Cuts\")))"
    test.assert_eq(read(text).layers, 4)

@test
fn test_tracks_vias_and_drills_give_their_smallest_values()
    let body = "(segment (start 1 1) (end 2 1) (width 0.25) (layer \"F.Cu\")) (segment (start 1 4) (end 2 4) (layer \"F.Cu\")) (segment (start 1 2) (end 2 2) (width 0.15) (layer \"F.Cu\")) (arc (start 1 3) (mid 2 3) (end 3 3) (width 0.2) (layer \"F.Cu\")) (via (at 5 5) (size 0.6) (drill 0.3) (layers \"F.Cu\" \"B.Cu\")) (via (at 6 5) (size 0.5) (drill 0.25) (layers \"F.Cu\" \"B.Cu\")) " + fp("A:B",
        "J1",
        "F.Cu",
        "5 5",
        "(pad \"1\" thru_hole circle (at 0 0) (size 1.7 1.7) (drill 1.0) (layers \"*.Cu\")) (pad \"2\" thru_hole oval (at 2 0) (size 1.5 2.5) (drill oval 0.9 1.6) (layers \"*.Cu\")) (pad \"\" np_thru_hole circle (at 4 0) (size 2 2) (drill 2.0) (layers \"*.Cu\")) (pad \"\" np_thru_hole circle (at 6 0) (size 1 1) (drill 0.7) (layers \"*.Cu\")) (pad \"3\" smd rect (at 8 0) (size 1 1) (layers \"F.Cu\"))")
    let b = read(board_text("", body))
    test.assert_eq(b.min_track, 0.15)
    test.assert_eq(b.min_via_drill, 0.25)
    test.assert_eq(b.min_via_size, 0.5)
    test.assert_eq(b.min_pth, 0.9)
    test.assert_eq(b.min_npth, 0.7)
    // The rings: vias (0.6 - 0.3) / 2 = 0.15 and (0.5 - 0.25) / 2 = 0.125;
    // pads (1.7 - 1.0) / 2 = 0.35 and (1.5 - 0.9) / 2 = 0.3.
    test.assert_approx(b.min_ring, 0.125, 0.0000001)

@test
fn test_a_board_with_no_track_via_or_drill_reports_zeros()
    let b = read(board_text("", ""))
    test.assert_eq(b.min_track, 0.0)
    test.assert_eq(b.min_via_drill, 0.0)
    test.assert_eq(b.min_pth, 0.0)
    test.assert_eq(b.min_npth, 0.0)
    test.assert_eq(b.min_ring, 0.0)

@test
fn test_the_centre_of_the_pads_is_found_in_the_footprints_frame_and_turned_to_the_board()
    // Pads of 1 by 1 at local (0, 0) and (4, 0): the box runs from -0.5 to
    // 4.5, so the centre is local (2, 0).  A footprint at (100, 100) turned
    // 90 degrees puts it at x' = 0, y' = -2 from the anchor.
    let pads = "(pad \"1\" smd rect (at 0 0 90) (size 1 1) (layers \"F.Cu\")) (pad \"2\" smd rect (at 4 0 90) (size 1 1) (layers \"F.Cu\"))"
    let b = read(board_text("", fp("L:N", "U1", "F.Cu", "100 100 90", pads)))
    let p = b.parts[0]
    test.assert_eq(p.ref, "U1")
    test.assert_eq(p.value, "vU1")
    test.assert_eq(p.name, "L:N")
    test.assert_eq(p.side, "top")
    test.assert_eq(p.x, 100.0)
    test.assert_eq(p.rot, 90.0)
    test.assert_eq(p.pads, 2)
    test.assert_approx(p.cx, 100.0, 0.0000001)
    test.assert_approx(p.cy, 98.0, 0.0000001)

@test
fn test_a_pad_turned_against_the_footprint_swaps_its_sides_and_other_angles_widen_the_box()
    // A 1 by 3 pad at the origin, turned 90 degrees relative to a footprint at 0:
    // its box is 3 wide and 1 high, and a second pad at local (4, 0) is 1 by 1.
    let pads = "(pad \"1\" smd rect (at 0 0 90) (size 1 3) (layers \"F.Cu\")) (pad \"2\" smd rect (at 4 0 0) (size 1 1) (layers \"F.Cu\"))"
    let b = read(board_text("", fp("L:N", "U1", "F.Cu", "0 0", pads)))
    // x from -1.5 to 4.5: centre 1.5.
    test.assert_approx(b.parts[0].cx, 1.5, 0.0000001)
    // A pad at 45 degrees: a 2 by 2 square turned 45 has half extents of 1.414.
    let diag = "(pad \"1\" smd rect (at 0 0 45) (size 2 2) (layers \"F.Cu\")) (pad \"2\" smd rect (at 5 0 45) (size 2 2) (layers \"F.Cu\"))"
    let c = read(board_text("", fp("L:N", "U1", "F.Cu", "0 0 45", diag)))
    test.assert_approx(c.parts[0].cx, 2.5 * math.cos(math.pi() / 4.0), 0.000001)
    let one = read(board_text("", fp("L:N", "U1", "F.Cu", "0 0", "(pad \"1\" smd rect (at 0 0) (size 2) (layers \"F.Cu\"))")))
    test.assert_approx(one.parts[0].cx, 0.0, 0.0000001)

@test
fn test_a_footprint_with_no_pads_has_its_anchor_for_a_centre_and_a_back_part_is_on_the_bottom()
    let b = read(board_text("", fp("L:Logo", "LOGO1", "B.Cu", "7 3 180", "")))
    let p = b.parts[0]
    test.assert_eq(p.side, "bottom")
    test.assert_eq(p.pads, 0)
    test.assert_eq(p.cx, 7.0)
    test.assert_eq(p.cy, 3.0)

@test
fn test_the_attributes_and_the_fields_of_a_footprint_are_read()
    let body = "(attr smd dnp exclude_from_pos_files exclude_from_bom) (property \"LCSC\" \"C1\") (property \"Rotation Offset\" \"90\")"
    let b = read(board_text("",
        fp("L:N", "R1", "F.Cu", "1 1", body) + fp("L:N", "R2", "F.Cu", "2 2", "(attr smd)") + fp("L:N", "R3", "F.Cu", "3 3", "") + "(footprint \"L:N\" (layer \"F.Cu\") (at 4 4) (property \"Reference\" \"R4\") (property \"Value\" \"DNP\"))"))
    test.assert(b.parts[0].dnp)
    test.assert(b.parts[0].no_pos)
    test.assert(b.parts[0].no_bom)
    test.assert_eq(fpboard.field(b.parts[0], "lcsc"), "C1")
    test.assert_eq(fpboard.field(b.parts[0], "Rotation Offset"), "90")
    test.assert_eq(fpboard.field(b.parts[0], "None"), "")
    test.assert(not b.parts[1].dnp and not b.parts[1].no_pos and not b.parts[1].no_bom)
    test.assert(not b.parts[2].dnp)
    test.assert(b.parts[3].dnp)
    test.assert_eq(fpboard.field_of(["A", "b"], ["1", "2"], "B"), "2")

@test
fn test_an_old_module_with_fp_text_is_read_like_a_footprint()
    let text = "(kicad_pcb (version 20171130) (general (thickness 1.6)) (layers (0 F.Cu signal) (31 B.Cu signal)) (gr_rect (start 0 0) (end 9 9) (layer Edge.Cuts)) (module L:N (layer F.Cu) (at 3 3) (fp_text reference U9 (at 0 0) (layer F.SilkS)) (fp_text value 74HC (at 0 0) (layer F.Fab)) (fp_text user note (at 0 0) (layer F.Fab)) (pad 1 smd rect (at 0 0) (size 1 1) (layers F.Cu))))"
    let b = read(text)
    test.assert_eq(b.layers, 2)
    test.assert_eq(b.parts[0].ref, "U9")
    test.assert_eq(b.parts[0].value, "74HC")

@test
fn test_a_file_that_is_not_a_board_or_not_s_expressions_is_refused_by_name()
    match fpboard.read(bytes.from_str("(kicad_sch)"), "x.kicad_pcb")
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(e.message(), "x.kicad_pcb:1:1: the file is not a kicad_pcb board")
    match fpboard.read(bytes.from_str("(kicad_pcb (version 20241229) (gr_rect (start 0 0) (end 4 4) (layer Edge.Cuts))"),
        "x.kicad_pcb")
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(e.message(), "x.kicad_pcb: 1:1: the list opened here is never closed")
