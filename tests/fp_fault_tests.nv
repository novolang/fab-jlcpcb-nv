// fp_fault_tests — the faults of the package: their messages and codes.

use std.test
use fpfault

@test
fn test_each_fault_has_a_message_that_names_what_failed()
    test.assert_eq(FpFile("a.csv", "cannot be read").message(), "a.csv: cannot be read")
    test.assert_eq(FpBoard("b.kicad_pcb: no outline").message(), "b.kicad_pcb: no outline")
    test.assert_eq(FpRevision("rev-A", ["x", "y"]).message(), "revision rev-A is not ready for a package: x; y")

@test
fn test_each_fault_has_a_short_stable_code()
    test.assert_eq(fpfault.code_of(FpFile("a", "b")), "file")
    test.assert_eq(fpfault.code_of(FpBoard("a")), "board")
    test.assert_eq(fpfault.code_of(FpRevision("a", [])), "revision")
