// fj_data_tests — the tables the package carries: their shape, their
// sources, and the figures they hold, each as the manufacturer's page
// gave it.

use std.test
use fjbom
use fjdata

@test
fn test_the_rotation_table_has_the_rows_of_its_source_in_order()
    let rows = fjdata.rotations()
    // 49 rows in the source, plus one for the look-ahead row that is two
    // here, plus the row `^SOT-23-5` that the source does not have.
    test.assert_eq(list.len(rows), 54)
    test.assert_eq(rows[0].pattern, "^Bosch_LGA-")
    test.assert_eq(rows[0].rotation, 90.0)
    test.assert_eq(rows[list.len(rows) - 1].pattern, "^qfn-")
    for r in rows
        test.assert_eq(r.dx, 0.0)
        test.assert_eq(r.dy, 0.0)
        test.assert(str.starts_with(r.pattern, "^"))

@test
fn test_the_row_for_the_five_lead_package_stands_before_the_row_that_would_match_it_first()
    let rows = fjdata.rotations()
    var five = -1
    var three = -1
    var at = 0
    for r in rows
        if r.pattern == "^SOT-23-5"
            five = at
        if r.pattern == "^SOT-23"
            three = at
        at += 1
    test.assert(five >= 0)
    test.assert(five < three)
    test.assert_eq(rows[five].rotation, 270.0)
    test.assert_eq(rows[three].rotation, 180.0)
    test.assert(str.contains(fjdata.sources()[0], "^SOT-23-5"))

@test
fn test_the_look_ahead_row_of_the_source_is_written_as_two_rows_with_the_same_answers()
    let rows = fjdata.rotations()
    let at = list.find(rows, r => r.pattern == "^SOP-18_")
    test.assert(at != None)
    let sop = list.find(rows, r => r.pattern == "^SOP-")
    test.assert(sop != None)
    test.assert_eq(list.len(list.filter(rows, r => str.contains(r.pattern, "(?!"))), 0)

@test
fn test_the_headers_are_those_of_the_manufacturers_sample_files()
    test.assert_eq(fjdata.bom_header(), ["Comment", "Designator", "Footprint", "JLCPCB Part #"])
    test.assert_eq(fjdata.cpl_header(), ["Designator", "Mid X", "Mid Y", "Rotation", "Layer"])
    test.assert_eq(list.len(fjdata.sources()), 6)
    test.assert(str.contains(fjdata.sources()[0], "7f627b6be76081b962161b9eb9fe3a326a18c915"))
    test.assert(str.contains(fjdata.sources()[1], "order form on 2026-11-25"))

@test
fn test_the_limits_are_the_figures_of_the_capabilities_page()
    let l = fjdata.limits()
    test.assert_eq(l.layers_max, 32)
    test.assert_eq(l.track_2, 0.10)
    test.assert_eq(l.track_n, 0.09)
    test.assert_eq(l.drill_2, 0.15)
    test.assert_eq(l.annular_2, 0.18)
    test.assert_eq(l.annular_n, 0.15)
    test.assert_eq(l.annular_rec_2, 0.25)
    test.assert_eq(l.annular_rec_n, 0.20)
    test.assert_eq(l.npth_drill, 0.5)
    test.assert_eq(l.thickness_min, 0.4)
    test.assert_eq(l.thickness_max, 4.5)
    test.assert_eq(l.smd_pad, 0.25)
    test.assert_eq(l.via_diameter_over_drill, 0.1)
    test.assert_eq(l.via_diameter_min, 0.25)

@test
fn test_the_two_assembly_classes_and_the_largest_sizes_by_layer_count()
    let a = fjdata.assemblies()
    test.assert_eq(a[0].name, "Economic")
    test.assert_eq(a[0].both_sides, false)
    test.assert_eq(a[0].layers_max, 6)
    test.assert_eq(a[0].qty_max, 50)
    test.assert_eq(a[1].name, "Standard")
    test.assert_eq(a[1].both_sides, true)
    test.assert_eq(a[1].width_min, 70.0)
    test.assert_eq(a[1].qty_max, 80000)
    test.assert_eq(fjdata.max_size(1), [606.0, 510.0])
    test.assert_eq(fjdata.max_size(2), [670.0, 600.0])
    test.assert_eq(fjdata.max_size(3), [663.0, 593.0])
    test.assert_eq(fjdata.max_size(4), [663.0, 593.0])
    test.assert_eq(fjdata.max_size(6), [656.0, 586.0])
    test.assert_eq(fjdata.max_size(20), [656.0, 586.0])

@test
fn test_the_economic_table_has_the_eleven_rows_of_the_form_and_the_lookup_takes_layers_thickness_and_quantity()
    let rows = fjdata.economic_rows()
    test.assert_eq(list.len(rows), 11)
    test.assert_eq(list.map(rows, r => r.layers), [2, 2, 2, 2, 2, 2, 2, 4, 4, 4, 6])
    test.assert_eq(list.map(rows, r => r.thickness), [0.8, 1.0, 1.2, 1.6, 1.6, 1.6, 1.6, 1.0, 1.2, 1.6, 1.6])
    test.assert_eq(list.map(rows, r => r.qty_min), [2, 2, 2, 2, 2, 5, 5, 2, 2, 2, 2])
    test.assert_eq(list.map(rows, r => r.qty_max), [30, 30, 30, 50, 50, 30, 30, 30, 50, 50, 30])
    test.assert_eq(rows[6].colours, ["Red", "White"])
    test.assert_eq(rows[6].finishes, ["Leaded HASL"])
    test.assert_eq(rows[10].finishes, ["ENIG"])
    // Layers and thickness select the rows; a thickness is matched within 0.005 mm.
    test.assert_eq(list.len(fjdata.economic_choices(2, 1.6, 0)), 4)
    test.assert_eq(list.len(fjdata.economic_choices(2, 1.598, 0)), 4)
    test.assert_eq(list.len(fjdata.economic_choices(2, 1.2, 0)), 1)
    test.assert_eq(list.len(fjdata.economic_choices(4, 1.6, 0)), 1)
    test.assert_eq(fjdata.economic_choices(6, 1.6, 0)[0].finishes, ["ENIG"])
    // A quantity keeps the rows that take it.
    test.assert_eq(list.len(fjdata.economic_choices(2, 1.6, 2)), 2)
    test.assert_eq(list.len(fjdata.economic_choices(2, 1.6, 5)), 4)
    test.assert_eq(list.len(fjdata.economic_choices(2, 1.6, 31)), 2)
    test.assert_eq(list.len(fjdata.economic_choices(2, 1.6, 51)), 0)
    test.assert_eq(list.len(fjdata.economic_choices(6, 1.6, 31)), 0)
    // No row for any other layer count or thickness.
    test.assert_eq(list.len(fjdata.economic_choices(8, 1.6, 0)), 0)
    test.assert_eq(list.len(fjdata.economic_choices(1, 1.6, 0)), 0)
    test.assert_eq(list.len(fjdata.economic_choices(6, 1.2, 0)), 0)
    test.assert_eq(list.len(fjdata.economic_choices(2, 2.0, 0)), 0)

@test
fn test_every_part_entry_has_a_part_number_a_status_a_side_and_a_date_and_none_is_listed_twice()
    let rows = fjdata.part_rotations()
    test.assert_eq(list.len(rows), 33)
    var seen: [Str] = []
    for r in rows
        test.assert(fjbom.part_number_ok(r.part))
        test.assert(r.status == "verified" or r.status == "proposed")
        test.assert(list.len(r.sides) > 0)
        for s in r.sides
            test.assert(s == "top" or s == "bottom")
        test.assert(r.seen == "2026-11-25" or r.seen == "2026-11-26")
        test.assert(r.note != "")
        test.assert_eq(r.dx, 0.0)
        test.assert_eq(r.dy, 0.0)
        test.assert(r.rotation >= 0.0 and r.rotation < 360.0)
        test.assert(not list.contains(seen, r.part))
        list.push(seen, r.part)

@test
fn test_every_entry_is_verified_and_the_four_parts_drawn_wrong_on_2026_11_25_were_seen_right_on_2026_11_26()
    let rows = fjdata.part_rotations()
    test.assert_eq(list.len(list.filter(rows, r => r.status == "proposed")), 0)
    test.assert_eq(list.len(list.filter(rows, r => r.status == "verified")), 33)
    let later = list.filter(rows, r => r.seen == "2026-11-26")
    test.assert_eq(list.map(later, r => r.part), ["C295747", "C2895249", "C2652978", "C404280"])
    test.assert_eq(list.map(later, r => r.rotation), [0.0, 0.0, 270.0, 90.0])
    test.assert(list.all(later, r => r.sides == ["top"]))
    // The parts that stand on both sides of the bottom-side kit were seen on both.
    let both = list.filter(rows, r => list.len(r.sides) == 2)
    test.assert_eq(list.len(both), 9)
    test.assert(list.all(both, r => r.status == "verified"))
    // The three-lead and five-lead packages, as the two kits showed them.
    let sot3 = list.find(rows, r => r.part == "C347478")
    test.assert_eq((sot3 ?? rows[0]).rotation, 180.0)
    let sot5 = list.find(rows, r => r.part == "C51118")
    test.assert_eq((sot5 ?? rows[0]).rotation, 270.0)
