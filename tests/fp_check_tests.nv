// fp_check_tests — each check of the package, passing and failing, on
// boards built in the test so that every figure can be worked out by hand.

use std.test
use fpboard
use fpbom
use fpcheck
use fpcpl
use fpdata

fn part(ref: Str, name: Str, side: Str, x: Float, y: Float) -> Part
    Part { ref: ref,
        value: "v",
        name: name,
        side: side,
        x: x,
        y: y,
        rot: 0.0,
        cx: x,
        cy: y,
        pads: 2,
        dnp: false,
        no_pos: false,
        no_bom: false,
        keys: [],
        vals: [] }

fn board(parts: [Part]) -> FabBoard
    FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 40.0,
        height: 30.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: parts }

fn line(ds: [Str], footprint: Str, part_no: Str) -> BomLine
    BomLine { designators: ds, comment: "c", footprint: footprint, part: part_no, dnp: false }

fn good_parts() -> [Part]
    [part("R1", "L:R_0603", "top", 1.0, 1.0), part("R2", "L:R_0603", "top", 2.0, 2.0)]

fn good_bom() -> [BomLine]
    [line(["R1", "R2"], "L:R_0603", "C21190")]

fn good_pos() -> Str
    "Ref,Val,Package,PosX,PosY,Rot,Side\nR1,v,L:R_0603,1,-1,0,top\nR2,v,L:R_0603,2,-2,0,top\n"

fn no_rules() -> Rules
    fpcheck.rules_of("")

// The checks of a board with the given bill, position text, rules and quantity.
fn run(b: FabBoard, bom: [BomLine], pos: Str, r: Rules, qty: Int) -> [FpCheck]
    fpcheck.run(b, fpcpl.rows(b, []), bom, pos, r, qty)

fn named(cs: [FpCheck], name: Str) -> FpCheck
    var out = FpCheck { name: "missing ${name}", ok: false, severity: "error", detail: "" }
    for c in cs
        if c.name == name
            out = c
    out

@test
fn test_a_board_that_agrees_with_itself_passes_every_check()
    let cs = run(board(good_parts()), good_bom(), good_pos(), no_rules(), 5)
    test.assert_eq(list.len(cs), 15)
    test.assert_eq(list.len(list.filter(cs, c => not c.ok)), 0)
    test.assert_eq(named(cs, "assembly-class").detail,
        "Economic assembly: single-sided, up to 6 layers, 0.8 to 1.6 mm")
    test.assert(fpcheck.passes(cs))
    test.assert_eq(fpcheck.report(cs)[0], "ok       designators-unique  every designator is used once")

@test
fn test_a_designator_used_twice_on_the_board_or_in_the_bill_is_an_error()
    let two = [part("R1", "L:R_0603", "top", 1.0, 1.0),
        part("r1", "L:R_0603", "top", 2.0, 2.0),
        part("U**", "L:X", "top", 3.0, 3.0),
        part("U**", "L:X", "top", 4.0, 4.0)]
    let c = named(run(board(two), good_bom(), good_pos(), no_rules(), 0), "designators-unique")
    test.assert_eq(c.ok, false)
    test.assert_eq(c.severity, "error")
    test.assert_eq(c.detail, "the board uses R1 twice")
    let bill = [line(["R1", "R2"], "L:R_0603", "C1"), line(["r2"], "L:R_0603", "C1")]
    let d = named(run(board(good_parts()), bill, good_pos(), no_rules(), 0), "designators-unique")
    test.assert_eq(d.detail, "the bill lists R2 twice")

@test
fn test_a_placed_part_with_no_part_number_is_an_error_naming_the_parts_and_a_part_marked_not_placed_is_not()
    let bill = [line(["R1"], "L:R_0603", "C1"), line(["R2"], "L:R_0603", "")]
    let c = named(run(board(good_parts()), bill, good_pos(), no_rules(), 0), "part-numbers")
    test.assert_eq(c.ok, false)
    test.assert_eq(c.detail, "1 placed part(s) have no part number in the bill: R2")
    // R2 do-not-populate: it is neither placed nor in need of a number.
    let dnp = [Part { ref: "R2",
        value: "v",
        name: "L:R_0603",
        side: "top",
        x: 2.0,
        y: 2.0,
        rot: 0.0,
        cx: 2.0,
        cy: 2.0,
        pads: 2,
        dnp: true,
        no_pos: false,
        no_bom: false,
        keys: [],
        vals: [] }]
    let b = board([good_parts()[0], dnp[0]])
    let cs = run(b,
        [line(["R1"], "L:R_0603", "C1")],
        "Ref,Val,Package,PosX,PosY,Rot,Side\nR1,v,L:R_0603,1,-1,0,top\n",
        no_rules(),
        0)
    test.assert(named(cs, "part-numbers").ok)
    test.assert(named(cs, "bom-cpl-agree").ok)
    let many = [part("A1", "L:X", "top", 0.0, 0.0),
        part("A2", "L:X", "top", 0.0, 0.0),
        part("A3", "L:X", "top", 0.0, 0.0),
        part("A4", "L:X", "top", 0.0, 0.0),
        part("A5", "L:X", "top", 0.0, 0.0),
        part("A6", "L:X", "top", 0.0, 0.0),
        part("A7", "L:X", "top", 0.0, 0.0),
        part("A8", "L:X", "top", 0.0, 0.0),
        part("A9", "L:X", "top", 0.0, 0.0),
        part("B1", "L:X", "top", 0.0, 0.0),
        part("B2", "L:X", "top", 0.0, 0.0),
        part("B3", "L:X", "top", 0.0, 0.0)]
    let c2 = named(run(board(many), [], "", no_rules(), 0), "part-numbers")
    test.assert(str.contains(c2.detail, "and 2 more"))
    test.assert(str.starts_with(c2.detail, "12 placed part(s)"))

@test
fn test_a_part_number_that_is_not_c_and_digits_is_an_error()
    let bill = [line(["R1"], "L:R_0603", "25804"), line(["R2"], "L:R_0603", "C21190")]
    let c = named(run(board(good_parts()), bill, good_pos(), no_rules(), 0), "part-number-format")
    test.assert_eq(c.ok, false)
    test.assert_eq(c.detail, "R1 has \"25804\", which is not C and digits")

@test
fn test_the_bill_and_the_placement_file_must_name_the_same_parts_in_both_directions()
    let bill = [line(["R1", "R7"], "L:R_0603", "C1")]
    let c = named(run(board(good_parts()), bill, good_pos(), no_rules(), 0), "bom-cpl-agree")
    test.assert_eq(c.ok, false)
    test.assert_eq(c.detail, "in the bill and not placed: R7; placed and not in the bill: R2")

@test
fn test_a_footprint_that_differs_between_the_bill_and_the_board_is_a_warning_and_a_designator_missing_from_the_board_is_not_reported_here()
    let bill = [line(["R1", "R2", "R9"], "L:R_0402", "C1")]
    let c = named(run(board(good_parts()), bill, good_pos(), no_rules(), 0), "footprints-agree")
    test.assert_eq(c.ok, false)
    test.assert_eq(c.severity, "warning")
    test.assert_eq(c.detail, "R1: bill L:R_0402, board L:R_0603; R2: bill L:R_0402, board L:R_0603")

@test
fn test_kicads_position_file_must_give_the_boards_anchors_with_the_y_flipped_and_the_side_the_same()
    let off = "Ref,Val,Package,PosX,PosY,Rot,Side\nR1,v,P,1.5,-1,0,top\nR2,v,P,2,2,0,top\nR3,v,P,9,9,0,top\nshort,row\n"
    let c = named(run(board(good_parts()), good_bom(), off, no_rules(), 0), "positions-agree")
    test.assert_eq(c.ok, false)
    test.assert(str.contains(c.detail, "R1: KiCad says (1.5, -1, 0, top), the board (1, -1, 0, top)"))
    test.assert(str.contains(c.detail, "R2: KiCad says (2, 2, 0, top), the board (2, -2, 0, top)"))
    test.assert(str.contains(c.detail, "R3 is in KiCad's position file and not on the board"))
    let turned = "Ref,Val,Package,PosX,PosY,Rot,Side\nR1,v,P,1,-1,90,top\nR2,v,P,2,-2,360,top\n"
    let d = named(run(board(good_parts()), good_bom(), turned, no_rules(), 0), "positions-agree")
    test.assert(str.contains(d.detail, "R1: KiCad says"))
    test.assert(not str.contains(d.detail, "R2: KiCad says"))
    let side = "Ref,Val,Package,PosX,PosY,Rot,Side\nR1,v,P,1,-1,0,bottom\nR2,v,P,2,-2,0,top\n"
    test.assert_eq(named(run(board(good_parts()), good_bom(), side, no_rules(), 0), "positions-agree").ok, false)

@test
fn test_the_assembly_class_follows_the_sides_the_layers_the_thickness_and_the_quantity()
    let top = board(good_parts())
    test.assert_eq(fpcheck.class_of(top, 5), "Economic")
    test.assert_eq(fpcheck.class_of(top, 0), "Economic")
    test.assert_eq(fpcheck.class_of(top, 1), "Standard")
    test.assert_eq(fpcheck.class_of(top, 51), "Standard")
    let bottom = board([part("R1", "L:R", "bottom", 1.0, 1.0)])
    test.assert_eq(fpcheck.class_of(bottom, 5), "Standard")
    let eight = FabBoard { file: "b",
        layers: 8,
        thickness: 1.6,
        width: 90.0,
        height: 90.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(fpcheck.class_of(eight, 5), "Standard")
    let one = FabBoard { file: "b",
        layers: 1,
        thickness: 1.6,
        width: 90.0,
        height: 90.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(fpcheck.class_of(one, 5), "Standard")
    let thin = FabBoard { file: "b",
        layers: 2,
        thickness: 0.6,
        width: 90.0,
        height: 90.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(fpcheck.class_of(thin, 5), "Standard")
    let thick = FabBoard { file: "b",
        layers: 2,
        thickness: 2.0,
        width: 90.0,
        height: 90.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(fpcheck.class_of(thick, 5), "Standard")

@test
fn test_a_board_below_the_assembly_minimum_or_outside_its_quantities_is_a_warning()
    let both = [part("R1", "L:R_0603", "bottom", 1.0, 1.0), part("R2", "L:R_0603", "top", 2.0, 2.0)]
    let small = named(run(board(both), good_bom(), good_pos(), no_rules(), 5), "assembly-class")
    test.assert_eq(small.severity, "warning")
    test.assert(str.contains(small.detail, "takes a single board of"))
    test.assert(str.contains(small.detail, "needs a panel"))
    let big = FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 90.0,
        height: 90.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: good_parts() }
    test.assert(named(run(big, good_bom(), good_pos(), no_rules(), 5), "assembly-class").ok)
    test.assert(named(run(big, good_bom(), good_pos(), no_rules(), 0), "assembly-class").ok)
    let many = named(run(big, good_bom(), good_pos(), no_rules(), 90000), "assembly-class")
    test.assert_eq(many.ok, false)
    test.assert(str.contains(many.detail, "pieces, not 90000"))
    test.assert(str.contains(named(run(big, good_bom(), good_pos(), no_rules(), 1), "assembly-class").detail,
        "pieces, not 1"))

@test
fn test_the_board_size_is_within_three_by_three_and_the_largest_for_its_layers()
    let tiny = FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 2.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert(str.contains(named(run(tiny, [], "", no_rules(), 0), "board-size").detail, "3 by 3 mm at the least"))
    let huge = FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 700.0,
        height: 100.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert(str.contains(named(run(huge, [], "", no_rules(), 0), "board-size").detail, "at most 670 by 600"))
    let turned = FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 600.0,
        height: 660.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert(named(run(turned, [], "", no_rules(), 0), "board-size").ok)

@test
fn test_the_layer_count_and_the_thickness_are_within_the_manufacturers_range()
    let many = FabBoard { file: "b",
        layers: 34,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(named(run(many, [], "", no_rules(), 0), "layers").detail,
        "34 copper layers: the manufacturer makes 1 to 32")
    let none = FabBoard { file: "b",
        layers: 0,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(named(run(none, [], "", no_rules(), 0), "layers").ok, false)
    let thin = FabBoard { file: "b",
        layers: 2,
        thickness: 0.2,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(named(run(thin, [], "", no_rules(), 0), "thickness").detail,
        "0.2 mm: the manufacturer makes 0.4 to 4.5")
    let thick = FabBoard { file: "b",
        layers: 2,
        thickness: 5.0,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(named(run(thick, [], "", no_rules(), 0), "thickness").ok, false)

@test
fn test_a_track_narrower_than_the_least_for_the_layer_count_is_an_error_and_a_wider_one_passes()
    let two = FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.09,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(named(run(two, [], "", no_rules(), 0), "track-width").detail,
        "the narrowest track is 0.09 mm, the manufacturer's least is 0.1 for 2 layers at 1 oz")
    let four = FabBoard { file: "b",
        layers: 4,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.09,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(named(run(four, [], "", no_rules(), 0), "track-width").detail,
        "the narrowest track is 0.09 mm, the least is 0.09")
    test.assert_eq(named(run(board([]), [], "", no_rules(), 0), "track-width").detail, "the board has no track")

@test
fn test_the_projects_rule_minimums_below_the_manufacturers_least_are_a_warning()
    let pro = "{\"board\": {\"design_settings\": {\"rules\": {\"min_track_width\": 0.05, \"min_clearance\": 0.05, \"min_through_hole_diameter\": 0.1, \"min_via_diameter\": 0.3, \"min_via_annular_width\": 0.05}}}}"
    let r = fpcheck.rules_of(pro)
    test.assert_eq(r.track, 0.05)
    test.assert_eq(r.via, 0.3)
    let c = named(run(board([]), [], "", r, 0), "clearance-setting")
    test.assert_eq(c.ok, false)
    test.assert_eq(c.severity, "warning")
    test.assert(str.contains(c.detail, "tracks of 0.05 mm"))
    test.assert(str.contains(c.detail, "a clearance of 0.05 mm"))
    test.assert(str.contains(c.detail, "a through hole of 0.1 mm"))
    test.assert(str.contains(c.detail, "an annular width of 0.05 mm"))
    let four = FabBoard { file: "b",
        layers: 4,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert(str.contains(named(run(four, [], "", r, 0), "clearance-setting").detail, "the manufacturer's least is 0.15"))
    let ok = fpcheck.rules_of("{\"board\": {\"design_settings\": {\"rules\": {\"min_track_width\": 0.2}}}}")
    test.assert(named(run(board([]), [], "", ok, 0), "clearance-setting").ok)
    for t in ["", "{}", "{\"board\": {}}", "{\"board\": {\"design_settings\": {}}}", "not json"]
        test.assert_eq(fpcheck.rules_of(t).track, 0.0)

@test
fn test_the_smallest_drills_and_vias_are_held_to_the_capability_table()
    let bad = FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.1,
        min_via_size: 0.15,
        min_pth: 0.1,
        min_npth: 0.3,
        min_ring: 0.0,
        parts: [] }
    let d = named(run(bad, [], "", no_rules(), 0), "drill")
    test.assert_eq(d.ok, false)
    test.assert(str.contains(d.detail, "smallest via drill is 0.1 mm, the least is 0.15"))
    test.assert(str.contains(d.detail, "smallest plated drill is 0.1 mm"))
    test.assert(str.contains(d.detail, "smallest non-plated drill is 0.3 mm, the least is 0.5"))
    test.assert(str.contains(d.detail, "less than 0.1 larger than its drill"))
    test.assert(str.contains(d.detail, "the smallest via is 0.15 mm across, the least is 0.25"))
    let one = FabBoard { file: "b",
        layers: 1,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.2,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.0,
        parts: [] }
    test.assert(str.contains(named(run(one, [], "", no_rules(), 0), "drill").detail, "the least is 0.3"))
    let fine = FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.3,
        min_via_size: 0.6,
        min_pth: 0.8,
        min_npth: 3.2,
        min_ring: 0.0,
        parts: [] }
    test.assert_eq(named(run(fine, [], "", no_rules(), 0), "drill").detail,
        "smallest via drill 0.3, plated drill 0.8, non-plated drill 3.2 (mm); the least is 0.15")

@test
fn test_an_annular_ring_below_the_least_is_an_error_and_the_recommendation_is_stated()
    let thin = FabBoard { file: "b",
        layers: 2,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.1,
        parts: [] }
    test.assert_eq(named(run(thin, [], "", no_rules(), 0), "annular-ring").detail,
        "the smallest annular ring is 0.1 mm, the absolute least is 0.18")
    let ok = FabBoard { file: "b",
        layers: 4,
        thickness: 1.6,
        width: 50.0,
        height: 50.0,
        aux_x: 0.0,
        aux_y: 0.0,
        min_track: 0.0,
        min_via_drill: 0.0,
        min_via_size: 0.0,
        min_pth: 0.0,
        min_npth: 0.0,
        min_ring: 0.2,
        parts: [] }
    test.assert_eq(named(run(ok, [], "", no_rules(), 0), "annular-ring").detail,
        "the smallest annular ring is 0.2 mm, the least is 0.15 and 0.2 is recommended")

@test
fn test_a_corrected_rotation_is_a_warning_to_review_and_a_report_line_is_made_for_each_check()
    let b = board([part("U1", "L:SOIC-8", "top", 1.0, 1.0)])
    let cs = run(b,
        [line(["U1"], "L:SOIC-8", "C1")],
        "Ref,Val,Package,PosX,PosY,Rot,Side\nU1,v,L:SOIC-8,1,-1,0,top\n",
        no_rules(),
        0)
    test.assert_eq(named(cs, "rotations").ok, true)
    let rows = fpcpl.rows(b, fpdata.rotations())
    let c = fpcheck.run(b,
        rows,
        [line(["U1"], "L:SOIC-8", "C1")],
        "Ref,Val,Package,PosX,PosY,Rot,Side\nU1,v,L:SOIC-8,1,-1,0,top\n",
        no_rules(),
        0)
    test.assert_eq(named(c, "rotations").detail,
        "1 placed part(s) have a rotation correction to review in the manufacturer's preview: U1")
    test.assert_eq(fpcheck.report(c)[14],
        "warning  rotations  1 placed part(s) have a rotation correction to review in the manufacturer's preview: U1")
    let failing = run(board(good_parts()), [], "", no_rules(), 0)
    test.assert(not fpcheck.passes(failing))
    test.assert(str.starts_with(fpcheck.report(failing)[1], "ERROR    part-numbers"))
